# BCM Navigator & Consulting System Environment Configuration
# Salin file ini menjadi .env sebelum menjalankan di server produksi:
# cp .env.example .env

# Mode lingkungan (production / development)
NODE_ENV=production

# Port aplikasi (default: 3000)
PORT=3000

# Nonaktifkan telemetri Next.js
NEXT_TELEMETRY_DISABLED=1

# SQLite database file path (relatif terhadap prisma/schema.prisma)
DATABASE_URL="file:./bcm_navigator.db"

# Secret untuk menandatangani (HMAC-SHA256) cookie sesi login (lihat src/lib/session.ts).
# WAJIB diisi sebelum menjalankan aplikasi — JANGAN pernah commit nilai asli ke file .env ini.
# Simpan nilai asli hanya di file .env.local (otomatis di-gitignore, lihat .gitignore).
# Cara generate secret acak yang kuat (minimal 32 byte):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=
